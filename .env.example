# Copy to .env.local and fill in. .env.local is gitignored — never commit it.

# https://aistudio.google.com/apikey — used for screenshot intake and plan prose only.
# The engine never asks Gemini for a number.
GEMINI_API_KEY=

# Path to the Firebase service account JSON (gitignored, lives in ./secrets/).
# Leave both Firebase vars empty to run against the local JSON store instead —
# the app degrades cleanly and the demo still works.
FIREBASE_SERVICE_ACCOUNT_PATH=./secrets/serviceAccount.json
# Alternative for Vercel: paste the whole JSON as one env var.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Single-owner passcode, sent as the x-owner-key header on write routes.
OWNER_KEY=
