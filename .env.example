# Copy to .env.local and fill in. .env.local is gitignored — never commit it.

# https://aistudio.google.com/apikey — used for screenshot intake and plan prose only.
# The engine never asks Gemini for a number.
GEMINI_API_KEY=

# Path to the Firebase service account JSON (gitignored, lives in ./secrets/).
# Leave both Firebase vars empty to run against the local JSON store instead —
# the app degrades cleanly and the demo still works.
FIREBASE_SERVICE_ACCOUNT_PATH=./secrets/serviceAccount.json
# Alternative for Vercel: paste the whole JSON as one env var.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Single-owner passcode, sent as the x-owner-key header on write routes.
# Also rides along as the OAuth `state` parameter, which is how the Gmail
# callback proves it came from our own auth route.
OWNER_KEY=

# --- Gmail (Layer 2b: usage evidence from message headers) -------------------
# Optional. Without these the Connect Gmail control does not render and
# everything else works exactly as before.
#
# From a Google Cloud project: APIs & Services -> Credentials -> OAuth client ID
# -> Web application. Add these redirect URIs:
#   http://localhost:3000/api/gmail/callback
#   https://<your-deployment>/api/gmail/callback
#
# The app requests the gmail.readonly scope. A bill's AMOUNT lives in the
# message body, so no narrower scope can read one — gmail.metadata gives headers
# only. Note there is also NO label-scoped or sender-scoped OAuth scope: the
# grant is mailbox-wide, and the label filter below is a promise this code keeps
# rather than one Google enforces.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=

# Only mail carrying this Gmail label is ever fetched. Create it in Gmail and
# apply it to the bills you want read in, and the order confirmations you want
# counted as proof a subscription is being used.
GMAIL_LABEL=zombie
# Ceiling on messages read per sync.
GMAIL_MAX_RESULTS=50

# --- Optional -----------------------------------------------------------------
# Forces the local JSON store (./data/zombie.json) even when Firebase
# credentials are present. This is how real financial data is kept off the
# public deployment during dogfooding — a tooling guarantee rather than a
# remembered habit.
ZOMBIE_STORE=

# Daily ceiling on chat questions, to keep the free-tier Gemini quota intact
# through a live demo. Defaults to 200 when unset.
CHAT_DAILY_LIMIT=
